{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Kanban Sprint & Retrospective Schema",
  "type": "object",
  "properties": {
    "sprints": {
      "type": "array",
      "items": { "$ref": "#/definitions/sprint" }
    },
    "retrospectiveCards": {
      "type": "array",
      "items": { "$ref": "#/definitions/retrospectiveCard" }
    },
    "tasks": {
      "type": "object",
      "description": "All known tasks, keyed by task id",
      "additionalProperties": { "$ref": "#/definitions/task" }
    }
  },
  "required": ["sprints", "retrospectiveCards", "tasks"],

  "definitions": {
    "sprint": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the sprint"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["Planning", "Active", "Completed"]
        },
        "taskIds": {
          "type": "array",
          "items": { "type": "string" },
          "description": "IDs of tasks assigned to this sprint"
        }
      },
      "required": ["id", "name", "status", "taskIds"],
      "additionalProperties": false
    },

    "retrospectiveCard": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the retrospective card"
        },
        "sprintId": {
          "type": "string",
          "description": "ID of the completed sprint this card belongs to"
        },
        "category": {
          "type": "string",
          "enum": ["Went Well", "To Improve", "Action Item"]
        },
        "content": {
          "type": "string",
          "description": "The text of the retrospective note"
        }
      },
      "required": ["id", "sprintId", "category", "content"],
      "additionalProperties": false
    },

    "task": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the task"
        },
        "status": {
          "type": "string",
          "enum": ["To Do", "In Progress", "Done"]
        },
        "sprintId": {
          "type": ["string", "null"],
          "description": "ID of the sprint this task is assigned to, or null if it is in the backlog"
        },
        "story_points": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "Estimation effort/size for the task, or null if not yet estimated"
        },
        "blocked": {
          "type": "boolean",
          "description": "Whether the task is currently blocked from progressing"
        },
        "blocker_reason": {
          "type": ["string", "null"],
          "description": "Why the task is blocked; required when blocked is true, null otherwise"
        },
        "dor_checklist": {
          "type": "object",
          "description": "Definition of Ready checklist, item name -> completed (bool)",
          "additionalProperties": { "type": "boolean" }
        },
        "dod_checklist": {
          "type": "object",
          "description": "Definition of Done checklist, item name -> completed (bool)",
          "additionalProperties": { "type": "boolean" }
        }
      },
      "required": [
        "id",
        "status",
        "sprintId",
        "story_points",
        "blocked",
        "blocker_reason",
        "dor_checklist",
        "dod_checklist"
      ],
      "additionalProperties": false
    }
  }
}
